    - target: {fileID: 6555182722502769573, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_text
      value: "\u2022 W Book Managerze mo\u017Cemy wybra\u0107, czy nasz projekt ma
        posiada\u0107 inwentarz, oraz z jakiego prefaba ma on korzysta\u0107 \n\u2022
        System jest napisany modularnie, dzi\u0119ki czemu programista mo\u017Ce
        stworzy\u0107 dowoln\u0105 klas\u0119 z w\u0142asnymi funkcjonalno\u015Bciami,
        wystarczy \u017Ce jego klasa b\u0119dziecie dziedziczy\u0107 po IInwentoryVisuals"
      objectReference: {fileID: 0}
