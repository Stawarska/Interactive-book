    - target: {fileID: 6555182722502769573, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_text
      value: "\u2022 Stworzona biblioteka mo\u017Ce by\u0107 wykorzystywana do realizacji
        r\xF3\u017Cnorodnych form interaktywnych, takich jak ksi\u0105\u017Cki paragrafowe,
        quizy, testy, materia\u0142y edukacyjne czy interaktywne prezentacje. \n\u2022
        Forma ko\u0144cowego projektu nie jest narzucona przez system i mo\u017Ce
        by\u0107 dowolnie kszta\u0142towana w zale\u017Cno\u015Bci od za\u0142o\u017Ce\u0144
        projektowych."
      objectReference: {fileID: 0}
