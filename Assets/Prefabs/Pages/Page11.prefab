      objectReference: {fileID: 3013741551601983292}
    - target: {fileID: 6201669281698029941, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_text
      value: Wymagania funkcjonalne designera
      objectReference: {fileID: 0}
    - target: {fileID: 6245519580763252434, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_Name
      value: Page11
      objectReference: {fileID: 0}
    - target: {fileID: 6555182722502769573, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_text
      value: "\u2022 Projektowanie ksi\u0105\u017Cki za pomoc\u0105 grafu, jej tre\u015Bci
        i po\u0142\u0105cze\u0144 pomi\u0119dzy wyborami korzystaj\u0105c z gotowych
        szablon\xF3w, lub przygotowywanie w\u0142asnych.\n\u2022 Tworzenie nowych
        zmiennych.  \n\u2022 Mo\u017Cliwo\u015B\u0107 dodawania akcji i warunk\xF3w
        do wybor\xF3w.\n\u2022 Mo\u017Cliwo\u015B\u0107 wybrania jednego z dost\u0119pnych
        wariant\xF3w animacji przewracania ksi\u0105\u017Cki.\n\u2022 Mo\u017Cliwo\u015B\u0107
        wybrania, czy ksi\u0105\u017Cka ma korzysta\u0107 z funkcji inwentarza i
        wyb\xF3r jednego z gotowych design\xF3w.\n\u2022 Mo\u017Cliwo\u015B\u0107
        dodawania, kt\xF3re zmienne maj\u0105 by\u0107 traktowane jako przedmiot
        do inwentarza.\n"
      objectReference: {fileID: 0}
