    - target: {fileID: 6201669281698029941, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_text
      value: Scene Reference Attribute
      objectReference: {fileID: 0}
    - target: {fileID: 6245519580763252434, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_Name
      value: Page39
      objectReference: {fileID: 0}
    - target: {fileID: 6555182722502769573, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_text
      value: "\u2022 The Scene Reference Attribute library is a set of attributes
        and tools used to search, filter, and serialize components and interfaces
        already at the editor stage, which reduces the need to use methods such as
        GetComponent or FindObject during execution.\n\u2022 Dependency search logic
        is moved to the OnValidate phase, reducing the cost of scene initialization
        and making object configuration more deterministic."
      objectReference: {fileID: 0}
