    - target: {fileID: 6555182722502769573, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_text
      value: "\u2022 In Book Manager, we can choose whether our project should have
        an inventory and which prefab it should use.\n\u2022 In inventory items data,
        we can add which variables from the global variables system should be treated
        as items, add a visual representation for them, and specify the name under
        which they should be displayed."
      objectReference: {fileID: 0}
