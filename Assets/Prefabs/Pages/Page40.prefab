    - target: {fileID: 6201669281698029941, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_text
      value: Unity SerializeReferenceExtensions
      objectReference: {fileID: 0}
    - target: {fileID: 6245519580763252434, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_Name
      value: Page40
      objectReference: {fileID: 0}
    - target: {fileID: 6555182722502769573, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_text
      value: "\u2022 The library extends the native capabilities of the SerializeReference
        attribute in Unity, providing an extensive set of editor tools for working
        with polymorphic types, such as abstract classes and interfaces, without
        the need to modify the engine's internal serialization mechanisms. \n\u2022
        Its main function is to allow convenient selection of a specific implementation
        of a given type directly in the Inspector, including in arrays and lists,
        while maintaining full compatibility with Unity's native serialization format."
      objectReference: {fileID: 0}
