    - target: {fileID: 6555182722502769573, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_text
      value: "\u2022 Framework Book - Page Curl is a free asset available in the
        Unity Asset Store that offers a ready-made page-turning animation with support
        for interactions involving grabbing and bending the page in accordance with
        mouse movements.\n\u2022 In the project, it has been significantly modified
        and adapted to individual needs, but the basic logic of operation comes from
        this solution."
      objectReference: {fileID: 0}
