    - target: {fileID: 6201669281698029941, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_text
      value: Functional requirements of a designer
      objectReference: {fileID: 0}
    - target: {fileID: 6245519580763252434, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_Name
      value: Page42
      objectReference: {fileID: 0}
    - target: {fileID: 6555182722502769573, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_text
      value: "\u2022 Designing a book using a graph, its content, and connections
        between choices using ready-made templates or preparing your own.\n\u2022
        Creating new variables.\n\u2022 The ability to add actions and conditions
        to choices.\n\u2022 Ability to choose one of the available book flipping
        animation options.\n\u2022 Ability to choose whether the book should use
        the inventory feature and select one of the ready-made designs.\n\u2022 Ability
        to add which variables should be treated as inventory items."
      objectReference: {fileID: 0}
