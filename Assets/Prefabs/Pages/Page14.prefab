    - target: {fileID: 6201669281698029941, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
      propertyPath: m_text
      value: Wymagania niefunkcjonalne
      objectReference: {fileID: 0}
    - target: {fileID: 6245519580763252434, guid: c658cfa27fd35ae4e9bd52abee519064, type: 3}
